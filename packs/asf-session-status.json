{
  "schema": "campfire.pack/v1",
  "profile": "steamcloud",
  "pack": "asf-session-status",
  "version": 1,
  "inputs_schema": "steamcloud.pack-input.session-status/v1",
  "steps": [
    {
      "id": "lease",
      "kind": "asf.resource.acquire",
      "needs": [],
      "resource_keys": [
        "steam-account:${account_id}"
      ],
      "on_uncertain": "fail_closed"
    },
    {
      "id": "inspect",
      "kind": "asf.account.session_status",
      "needs": [
        "lease"
      ],
      "on_uncertain": "reconcile"
    }
  ]
}
