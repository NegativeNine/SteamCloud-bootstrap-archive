{
  "schema": "campfire.pack/v1",
  "profile": "steamcloud",
  "pack": "asf-market-price-observe",
  "version": 1,
  "inputs_schema": "steamcloud.pack-input.market-price/v1",
  "steps": [
    {
      "id": "lease",
      "kind": "asf.resource.acquire",
      "needs": [],
      "resource_keys": [
        "egress:market-price",
        "market-pacer:${egress_id}:price"
      ],
      "on_uncertain": "fail_closed"
    },
    {
      "id": "fetch",
      "kind": "asf.steam.market.fetch",
      "needs": [
        "lease"
      ],
      "on_uncertain": "reconcile"
    },
    {
      "id": "artifact",
      "kind": "asf.artifact.put",
      "needs": [
        "fetch"
      ],
      "on_uncertain": "reconcile"
    },
    {
      "id": "publish",
      "kind": "asf.hypergraph.publish",
      "needs": [
        "artifact"
      ],
      "on_uncertain": "reconcile"
    }
  ]
}
