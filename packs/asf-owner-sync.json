{
  "schema": "campfire.pack/v1",
  "profile": "steamcloud",
  "pack": "asf-owner-sync",
  "version": 1,
  "inputs_schema": "steamcloud.pack-input.owner-sync/v1",
  "steps": [
    {
      "id": "admit",
      "kind": "asf.hypergraph.admit_collection",
      "needs": [],
      "on_uncertain": "fail_closed"
    },
    {
      "id": "wait_owner",
      "kind": "asf.owner.edge.wait",
      "needs": [
        "admit"
      ],
      "on_uncertain": "wait"
    },
    {
      "id": "fetch",
      "kind": "asf.owner.edge.fetch",
      "needs": [
        "wait_owner"
      ],
      "on_uncertain": "reconcile"
    },
    {
      "id": "artifact",
      "kind": "asf.artifact.put",
      "needs": [
        "fetch"
      ],
      "on_uncertain": "reconcile"
    },
    {
      "id": "publish",
      "kind": "asf.hypergraph.publish",
      "needs": [
        "artifact"
      ],
      "on_uncertain": "reconcile"
    }
  ]
}
