{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "repository",
    "sha",
    "role",
    "authority",
    "maturity",
    "findings",
    "commands",
    "limitations"
  ],
  "properties": {
    "repository": {
      "type": "string"
    },
    "sha": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "maturity": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "status"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
