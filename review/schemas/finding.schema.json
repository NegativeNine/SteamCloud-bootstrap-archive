{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-repository adversarial review finding",
  "type": "object",
  "required": [
    "id",
    "repository",
    "sha",
    "severity",
    "confidence",
    "category",
    "title",
    "claim",
    "sources",
    "scenario",
    "impact",
    "owner_repository",
    "remediation",
    "runtime_verification_required"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9._-]+$"
    },
    "repository": {
      "type": "string"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "confidence": {
      "enum": [
        "CONFIRMED_SOURCE",
        "CONFIRMED_EVIDENCE",
        "INFERRED",
        "RUNTIME_REQUIRED",
        "DISPUTED"
      ]
    },
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "start_line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "end_line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "scenario": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "affected_gate": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_repository": {
      "type": "string"
    },
    "consumer_repositories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reproduction": {
      "type": [
        "string",
        "null"
      ]
    },
    "remediation": {
      "type": "string"
    },
    "rollback_considerations": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_verification_required": {
      "type": "boolean"
    },
    "possibly_changed_after_snapshot": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
