{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.steamcloud.dev/campfire-pack/v1",
  "title": "SteamCloud data-only Campfire pack v1",
  "type": "object",
  "required": [
    "schema",
    "profile",
    "pack",
    "version",
    "inputs_schema",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "campfire.pack/v1"
    },
    "profile": {
      "const": "steamcloud"
    },
    "pack": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "inputs_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "needs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
          },
          "needs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "resource_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "on_uncertain": {
            "enum": [
              "reconcile",
              "wait",
              "fail_closed"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
