{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.steamcloud.dev/dependency-status/v1",
  "title": "Pinned dependency capability status v1",
  "type": "object",
  "required": [
    "schema",
    "repository",
    "sha",
    "observed_at",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": "platform.dependency-status/v1"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
      },
      "additionalProperties": {
        "enum": [
          "UNKNOWN",
          "BLOCKED",
          "IMPLEMENTED",
          "MEASURED",
          "QUALIFIED",
          "DEPLOYED",
          "AUTHORITATIVE"
        ]
      }
    }
  },
  "additionalProperties": false
}
