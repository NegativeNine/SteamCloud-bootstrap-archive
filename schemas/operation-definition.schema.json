{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.steamcloud.dev/operation-definition/v1",
  "title": "SteamCloud operation definition v1",
  "type": "object",
  "required": [
    "schema",
    "operation",
    "version",
    "risk_class",
    "policy_status",
    "account_classes",
    "action_kind",
    "retry_class",
    "maximum_runtime_seconds",
    "result_schema"
  ],
  "properties": {
    "schema": {
      "const": "steamcloud.operation-definition/v1"
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "risk_class": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "policy_status": {
      "enum": [
        "ENABLED",
        "USER_ACTION_REQUIRED",
        "PRIVATE_CANARY",
        "VALVE_APPROVAL_REQUIRED",
        "DISABLED_POLICY",
        "REMOVED"
      ]
    },
    "account_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CUSTOMER_LINKED",
          "PLATFORM_PUBLIC_BOT",
          "PLATFORM_FRIEND_BOT",
          "PLATFORM_MARKET_COLLECTOR",
          "PLATFORM_CATALOG_COLLECTOR",
          "PLATFORM_GC_CANARY",
          "TEST_CANARY",
          "EPHEMERAL_OWNER"
        ]
      }
    },
    "action_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "credential_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "egress_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "retry_class": {
      "enum": [
        "SAFE",
        "RECONCILE_BEFORE_RETRY",
        "NEVER_AUTOMATICALLY_RETRY"
      ]
    },
    "maximum_runtime_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "result_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "requires_human_approval": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
