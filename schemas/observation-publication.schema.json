{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.steamcloud.dev/observation-publication/v1",
  "title": "Steam Hypergraph observation publication v1",
  "type": "object",
  "required": [
    "schema",
    "publication_id",
    "permit_id",
    "artifact_digest",
    "subject",
    "scrape_class",
    "relation_assertions",
    "submitted_at"
  ],
  "properties": {
    "schema": {
      "const": "steam-hypergraph.observation-publication/v1"
    },
    "publication_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "permit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "string",
      "pattern": "^steam:[0-9]{17}$"
    },
    "scrape_class": {
      "enum": [
        "public",
        "privileged",
        "owner_session",
        "restricted_demo",
        "publisher",
        "service_account_self"
      ]
    },
    "relation_assertions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "relation_type",
          "participants"
        ],
        "properties": {
          "relation_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
          },
          "participants": {
            "type": "array",
            "minItems": 2,
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": [
                "node",
                "role",
                "ordinal"
              ],
              "properties": {
                "node": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "role": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
                },
                "ordinal": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
