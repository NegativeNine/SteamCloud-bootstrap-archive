{
  "schema": "campfire.pack/v1",
  "profile": "steamcloud",
  "pack": "asf-public-profile-refresh",
  "version": 1,
  "inputs_schema": "steamcloud.pack-input.public-profile/v1",
  "steps": [
    {
      "id": "admit",
      "kind": "asf.hypergraph.admit_collection",
      "needs": [],
      "on_uncertain": "fail_closed"
    },
    {
      "id": "fetch",
      "kind": "asf.steam.webapi.fetch",
      "needs": [
        "admit"
      ],
      "resource_keys": [
        "steam-account:${account_id}",
        "egress:webapi-public"
      ],
      "on_uncertain": "reconcile"
    },
    {
      "id": "publish",
      "kind": "asf.hypergraph.publish",
      "needs": [
        "fetch"
      ],
      "on_uncertain": "reconcile"
    }
  ]
}
