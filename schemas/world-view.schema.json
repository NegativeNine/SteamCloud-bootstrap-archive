{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.steamcloud.dev/world-view/v1",
  "title": "SteamCloud account world view v1",
  "type": "object",
  "required": [
    "schema",
    "account_id",
    "tenant_id",
    "runtime_state",
    "steam_state",
    "runtime_generation",
    "credential_generation",
    "observed_at"
  ],
  "properties": {
    "schema": {
      "const": "steamcloud.world-view/v1"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "runtime_state": {
      "enum": [
        "absent",
        "starting",
        "online",
        "busy",
        "degraded",
        "quarantined",
        "stopped"
      ]
    },
    "steam_state": {
      "enum": [
        "unlinked",
        "offline",
        "authenticating",
        "needs_user_action",
        "logged_on",
        "rate_limited",
        "revoked"
      ]
    },
    "web_session_state": {
      "enum": [
        "absent",
        "refreshing",
        "ready",
        "expired",
        "unsupported"
      ]
    },
    "gc_state": {
      "enum": [
        "disconnected",
        "connecting",
        "connected",
        "unsupported"
      ]
    },
    "runtime_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "egress_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_generation": {
      "type": "integer",
      "minimum": 0
    },
    "credential_generation": {
      "type": "integer",
      "minimum": 0
    },
    "active_challenge_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
