{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.steamcloud.dev/command-capability/v1",
  "title": "SteamCloud command capability v1",
  "type": "object",
  "required": [
    "schema",
    "issuer",
    "audience",
    "subject",
    "tenant_id",
    "operation",
    "arguments_sha256",
    "jti",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema": {
      "const": "steamcloud.command-capability/v1"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "audience": {
      "const": "urn:steamcloud:command"
    },
    "subject": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "account_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "arguments_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jti": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "additionalProperties": false
}
