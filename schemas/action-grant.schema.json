{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.steamcloud.dev/action-grant/v1",
  "title": "Campfire one-action grant v1",
  "type": "object",
  "required": [
    "schema",
    "issuer",
    "audience",
    "run_id",
    "work_id",
    "attempt_id",
    "action_intent_id",
    "operation",
    "arguments_sha256",
    "idempotency_key",
    "lease_fences",
    "expires_at"
  ],
  "properties": {
    "schema": {
      "const": "campfire.action-grant/v1"
    },
    "issuer": {
      "const": "urn:campfire:action-authority"
    },
    "audience": {
      "const": "urn:steamcloud:agent"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "work_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "action_intent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "account_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "arguments_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "lease_fences": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      },
      "maxProperties": 16
    },
    "credential_generation": {
      "type": "integer",
      "minimum": 0
    },
    "runtime_generation": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
