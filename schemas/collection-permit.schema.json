{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.steamcloud.dev/collection-permit/v1",
  "title": "Steam Hypergraph collection permit v1",
  "type": "object",
  "required": [
    "schema",
    "permit_id",
    "subject",
    "purpose",
    "allowed_sources",
    "allowed_scopes",
    "scrape_class",
    "maximum_calls",
    "policy_revision",
    "erasure_epoch",
    "expires_at"
  ],
  "properties": {
    "schema": {
      "const": "steam-hypergraph.collection-permit/v1"
    },
    "permit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "subject": {
      "type": "string",
      "pattern": "^steam:[0-9]{17}$"
    },
    "purpose": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "allowed_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "steam_web_api",
          "community_xml",
          "community_html",
          "community_session",
          "steam_catalog",
          "steam_market",
          "steam_gc",
          "owner_edge"
        ]
      }
    },
    "allowed_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
      }
    },
    "scrape_class": {
      "enum": [
        "public",
        "privileged",
        "owner_session",
        "restricted_demo",
        "publisher",
        "service_account_self"
      ]
    },
    "maximum_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "erasure_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
