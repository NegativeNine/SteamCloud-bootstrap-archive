  "properties": {
    "schema": { "const": "solarflare.repository-phase-closeout/v3" },
    "architecture_version": { "const": "2026-08-23-final-phased-prompts.3" },
    "repository": { "const": "NegativeNine/SteamCloud-bootstrap-archive" },
    "phase": { "const": "01" },
    "source_head": { "const": "9554180db2b73b426a87128e10fbe12c097ee786" },
    "source_tree": { "const": "e0a9e141f14bdfd3b90131ff0ec55551393777a8" },
    "change_commits": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
