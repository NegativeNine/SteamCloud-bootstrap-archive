    },
    "commands": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "result"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer", "minimum": 0 },
          "result": { "type": "string", "minLength": 1 }
        }
      }
    },
    "command_evidence_classification": {
      "const": "NARRATIVE_ONLY_NOT_INDEPENDENT_EXECUTION_EVIDENCE"
    },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest", "path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "capability_status": { "const": "IMPLEMENTED_NOT_QUALIFIED" },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rollback": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolved_blockers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blocker", "owner"],
        "properties": {
          "blocker": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unblocks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "work_items": {
      "const": [
        { "class": "implementation", "status": "IMPLEMENTED_ARCHIVE_ONLY" },
        { "class": "artifact", "status": "UNSIGNED_HISTORICAL_REFERENCE_NOT_ADMITTED" },
        { "class": "deployment", "status": "BLOCKED_NOT_AUTHORIZED_NOT_PERFORMED" },
        { "class": "activation", "status": "BLOCKED_NOT_AUTHORIZED_NOT_PERFORMED" },
        { "class": "authority", "status": "NONE_NOT_AUTHORIZED_NOT_PERFORMED" },
        { "class": "qualification", "status": "BLOCKED_NOT_ESTABLISHED" },
        { "class": "observation", "status": "LOCAL_SOURCE_EVIDENCE_ONLY_FRESH_EXACT_HEAD_REVIEW_REQUIRED" }
      ]
    },
    "authority_movement": {
      "const": { "authorized": false, "performed": false, "effect": "NONE" }
    },
    "review_gate": {
      "const": {
        "remediated_review_path": "coordinator-dag-execution-2026-08-24/reviews/steamcloud-bootstrap-archive/phase-01.independent-review.json",
        "remediated_review_sha256": "ce1a9936b879c7d5e1e59ab723b727afb2d683afed7dff1a336129ff0b2e46f8",
        "remediated_finding_ids": [
          "ARCHIVE-P1-R01",
          "ARCHIVE-P1-R02",
          "ARCHIVE-P1-R03",
          "ARCHIVE-P1-R04",
          "ARCHIVE-P1-R05",
          "ARCHIVE-P1-R06"
        ],
        "fresh_exact_head_review": "REQUIRED_NOT_YET_OBSERVED",
        "signed_acceptance": "NOT_OBSERVED",
        "qualification_effect": "NONE",
        "authority_effect": "NONE"
      }
    }
  }
}
