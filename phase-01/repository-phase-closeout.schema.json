{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.solarflare.dev/steamcloud-archive-phase-01-closeout.schema.json",
  "title": "SteamCloud archive Phase 01 closeout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architecture_version",
    "artifacts",
    "authority_movement",
    "capability_status",
    "change_commits",
    "command_evidence_classification",
    "commands",
    "known_limitations",
    "non_claims",
    "phase",
    "repository",
    "review_gate",
    "rollback",
    "schema",
    "source_head",
    "source_tree",
    "unblocks",
    "unresolved_blockers",
