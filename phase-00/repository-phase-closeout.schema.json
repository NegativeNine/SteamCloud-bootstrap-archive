{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.solarflare.dev/steamcloud-archive/repository-phase-closeout.v3.json",
  "title": "SteamCloud bootstrap archive Phase 00 closeout",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "identity", "evidence", "reason"],
      "properties": {
        "disposition": {
          "enum": ["EVIDENCED", "REPORTED_NOT_ADMITTED", "NOT_OBSERVED", "NOT_APPLICABLE"]
        },
        "identity": {},
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        },
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "required": [
    "schema",
    "architecture_version",
    "repository",
    "phase",
    "generated_at",
    "source_head",
    "source_refresh",
    "change_commits",
    "versions",
    "commands",
    "artifacts",
    "identities",
    "work_items",
    "phase_disposition",
    "canonical_capability_status",
    "completeness_vector",
    "known_limitations",
    "rollback",
    "non_claims",
    "unresolved_blockers",
    "unblocks",
    "authority_movement"
  ],
  "properties": {
    "schema": {"const": "solarflare.repository-phase-closeout/v3"},
    "architecture_version": {"const": "2026-08-23-final-phased-prompts.3"},
    "repository": {"const": "NegativeNine/SteamCloud-bootstrap-archive"},
    "phase": {"const": "00"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_head": {"$ref": "#/$defs/commit"},
    "source_refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "observed_at", "expires_at", "method", "signature_verified", "default_branch_protected", "rulesets_disposition"],
      "properties": {
        "branch": {"const": "main"},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "method": {"type": "string", "minLength": 1},
        "signature_verified": {"const": false},
        "default_branch_protected": {"const": false},
        "rulesets_disposition": {"const": "OBSERVED"}
      }
    },
    "change_commits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/commit"}
    },
    "versions": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]}
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "result_digest"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "result_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/digest"},
          "kind": {"type": "string", "minLength": 1}
        }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "artifact", "signed_release", "deployment", "profile", "limits", "jurisdiction", "authority_generation", "source_cut", "test_fault_corpus", "independent_review", "qualification", "observation_window", "rollback"],
      "properties": {
        "implementation": {"$ref": "#/$defs/identity"},
        "artifact": {"$ref": "#/$defs/identity"},
        "signed_release": {"$ref": "#/$defs/identity"},
        "deployment": {"$ref": "#/$defs/identity"},
        "profile": {"$ref": "#/$defs/identity"},
        "limits": {"$ref": "#/$defs/identity"},
        "jurisdiction": {"$ref": "#/$defs/identity"},
        "authority_generation": {"$ref": "#/$defs/identity"},
        "source_cut": {"$ref": "#/$defs/identity"},
        "test_fault_corpus": {"$ref": "#/$defs/identity"},
        "independent_review": {"$ref": "#/$defs/identity"},
        "qualification": {"$ref": "#/$defs/identity"},
        "observation_window": {"$ref": "#/$defs/identity"},
        "rollback": {"$ref": "#/$defs/identity"}
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "status", "description"],
        "properties": {
          "class": {"enum": ["implementation", "artifact", "deployment", "activation", "authority", "qualification", "observation"]},
          "status": {"enum": ["EVIDENCED", "BLOCKED", "NOT_APPLICABLE"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "phase_disposition": {"const": "IMPLEMENTED_NOT_QUALIFIED"},
    "canonical_capability_status": {"const": "UNKNOWN"},
    "completeness_vector": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "required": ["implementation", "artifact", "deployment", "profile", "limits", "authority_generation", "test_fault_corpus", "independent_review", "observation_window", "rollback_identity"]
    },
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "target_commit", "archive_digest", "independently_retrieved", "authority_effect"],
      "properties": {
        "path": {"const": "phase-00/rollback.v1.json"},
        "target_commit": {"$ref": "#/$defs/commit"},
        "archive_digest": {"$ref": "#/$defs/digest"},
        "independently_retrieved": {"type": "boolean"},
        "authority_effect": {"const": "NONE"}
      }
    },
    "non_claims": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "unresolved_blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "blocker", "owner", "hard"],
        "properties": {
          "id": {"type": "string"},
          "class": {"type": "string"},
          "blocker": {"type": "string"},
          "owner": {"type": "string"},
          "hard": {"type": "boolean"}
        }
      }
    },
    "unblocks": {"type": "array", "items": {"type": "string"}},
    "authority_movement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "performed", "effect"],
      "properties": {
        "authorized": {"const": false},
        "performed": {"const": false},
        "effect": {"const": "NONE"}
      }
    }
  }
}
